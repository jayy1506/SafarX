{
  "name": "sawangi-ride",
  "version": "1.0.0",
  "type": "module",
  "description": "Sawangi–Wardha Shared-Seat Ride Booking Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"import('fs').then(fs => fs.cpSync('dist', 'backend/dist', {recursive: true, force: true}))\"",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "seed": "tsx backend/src/seeders/seedData.ts",
    "test": "tsx --test backend/src/tests/**/*.test.ts"
  },
  "keywords": [
    "ride-booking",
    "mobility",
    "shared-rides",
    "wardha",
    "sawangi",
    "razorpay"
  ],
  "author": "SawangiRide Architecture Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2"
  }
}
